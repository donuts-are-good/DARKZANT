//kage:unit pixels

package main

// Scale is how many window pixels one game pixel covers.
var Scale float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	size := imageSrc0Size()

	// Barrel curve, like the bulge of an old tube.
	uv := (srcPos - origin) / size
	cc := uv - 0.5
	d := dot(cc, cc)
	uv += cc * d * 0.06
	if uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1 {
		return vec4(0, 0, 0, 1)
	}
	p := origin + uv*size

	// Slight colour fringing and phosphor glow.
	col := vec3(
		imageSrc0At(p+vec2(0.3, 0)).r,
		imageSrc0At(p).g,
		imageSrc0At(p-vec2(0.3, 0)).b,
	)
	glow := imageSrc0At(p+vec2(1, 0)).rgb + imageSrc0At(p-vec2(1, 0)).rgb +
		imageSrc0At(p+vec2(0, 1)).rgb + imageSrc0At(p-vec2(0, 1)).rgb
	col += glow * 0.07

	// Scanlines, softer when the window is small.
	depth := clamp((Scale-1.5)*0.18, 0, 0.4)
	col *= 1 - depth + depth*sin(fract(p.y)*3.14159)*1.3

	// Vignette.
	col *= 1.05 - d*0.8
	return vec4(col, 1)
}
